<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>1차시 수업 피드백</title>
    <style>
        body { font-family: 'Pretendard', sans-serif; background-color: #f4f7f6; margin: 0; padding: 20px; display: flex; justify-content: center; }
        .container { background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); max-width: 500px; width: 100%; position: relative; }
        h2 { color: #333; text-align: center; margin-bottom: 20px; }
        .question { margin-bottom: 20px; }
        .question label { font-weight: bold; color: #444; display: block; margin-bottom: 8px; font-size: 15px; }
        select, textarea { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px; font-family: inherit; font-size: 14px; box-sizing: border-box; }
        textarea { resize: vertical; min-height: 80px; }
        button.submit-btn { width: 100%; padding: 12px; background-color: #007bff; color: white; border: none; border-radius: 6px; font-size: 16px; font-weight: bold; cursor: pointer; transition: background 0.3s; }
        button.submit-btn:hover { background-color: #0056b3; }
        
        /* 관리자 버튼 (우측 하단 숨김 처리) */
        .admin-btn { position: absolute; bottom: 10px; right: 10px; opacity: 0.1; cursor: pointer; font-size: 12px; border: none; background: none; }
        .admin-btn:hover { opacity: 0.5; }
        
        /* 관리자 결과 화면 */
        #admin-panel { display: none; margin-top: 20px; padding-top: 20px; border-top: 2px dashed #ccc; }
        .result-item { background: #f9f9f9; padding: 10px; margin-bottom: 10px; border-radius: 6px; font-size: 13px; }
    </style>
</head>
<body>

<div class="container">
    <h2>🚀 오늘 수업 어땠나요?</h2>
    
    <!-- form 태그: action 속성에 Formspree 주소를 넣으면 이메일로도 받을 수 있습니다 -->
    <form id="feedbackForm" onsubmit="saveFeedback(event)">
        
        <div class="question">
            <label>1. 오늘 다룬 내용(알짜힘과 운동 방향, 속력의 변화)은 얼마나 이해하기 쉬웠나요?</label>
            <select id="q1" required>
                <option value="">선택해주세요</option>
                <option value="매우 이해하기 쉬웠다">매우 이해하기 쉬웠다</option>
                <option value="적당했다">적당했다</option>
                <option value="조금 어려웠다">조금 어려웠다</option>
                <option value="많이 어려웠다">많이 어려웠다</option>
            </select>
        </div>

        <div class="question">
            <label>2. 화면으로 본 놀이기구 시뮬레이션(빨간색 화살표)이 이해에 도움이 되었나요?</label>
            <select id="q2" required>
                <option value="">선택해주세요</option>
                <option value="매우 도움이 되었다">매우 도움이 되었다</option>
                <option value="꽤 도움이 되었다">꽤 도움이 되었다</option>
                <option value="보통이다">보통이다</option>
                <option value="별로 도움이 되지 않았다">별로 도움이 되지 않았다</option>
            </select>
        </div>

        <div class="question">
            <label>3. 오늘 수업 중 가장 기억에 남거나 재미있었던 활동(또는 놀이기구)은 무엇인가요?</label>
            <textarea id="q3" placeholder="자유롭게 적어주세요!" required></textarea>
        </div>

        <div class="question">
            <label>4. 헷갈리거나 다음 시간에 한 번 더 설명해 주었으면 하는 부분이 있나요?</label>
            <textarea id="q4" placeholder="없으면 '없음'이라고 적어주세요."></textarea>
        </div>

        <div class="question">
            <label>5. 다음 수업을 위해 선생님께 바라는 점이 있다면 자유롭게 적어주세요.</label>
            <textarea id="q5" placeholder="없으면 '없음'이라고 적어주세요."></textarea>
        </div>

        <button type="submit" class="submit-btn">제출하기</button>
    </form>

    <button class="admin-btn" onclick="openAdmin()">🔒</button>

    <div id="admin-panel">
        <h3 style="color: #d9534f;">선생님용 결과 확인</h3>
        <div id="results"></div>
        <button onclick="clearData()" style="margin-top:10px; padding:5px; font-size:12px;">데이터 초기화</button>
    </div>
</div>

<script>
    // 학생 제출 데이터 임시 저장 로직
    function saveFeedback(event) {
        event.preventDefault();
        const data = {
            time: new Date().toLocaleString(),
            q1: document.getElementById('q1').value,
            q2: document.getElementById('q2').value,
            q3: document.getElementById('q3').value,
            q4: document.getElementById('q4').value,
            q5: document.getElementById('q5').value
        };
        
        let feedbacks = JSON.parse(localStorage.getItem('wonbong_feedback')) || [];
        feedbacks.push(data);
        localStorage.setItem('wonbong_feedback', JSON.stringify(feedbacks));
        
        alert("제출이 완료되었습니다. 고맙습니다!");
        document.getElementById('feedbackForm').reset();
    }

    // 관리자 페이지 열기 (비밀번호: 1234)
    function openAdmin() {
        const pwd = prompt("관리자 비밀번호를 입력하세요:");
        if (pwd === "1234") {
            document.getElementById('admin-panel').style.display = "block";
            showResults();
        } else {
            alert("비밀번호가 틀렸습니다.");
        }
    }

    // 결과 보여주기
    function showResults() {
        const resultsDiv = document.getElementById('results');
        let feedbacks = JSON.parse(localStorage.getItem('wonbong_feedback')) || [];
        
        if (feedbacks.length === 0) {
            resultsDiv.innerHTML = "<p>아직 제출된 피드백이 없습니다.</p>";
            return;
        }

        let html = "";
        feedbacks.forEach((fb, index) => {
            html += `<div class="result-item">
                <strong>#${index + 1} (${fb.time})</strong><br>
                1. 난이도: ${fb.q1}<br>
                2. 시뮬레이션 도움: ${fb.q2}<br>
                3. 재밌었던 점: ${fb.q3}<br>
                4. 헷갈린 점: ${fb.q4}<br>
                5. 건의사항: ${fb.q5}
            </div>`;
        });
        resultsDiv.innerHTML = html;
    }

    // 데이터 초기화
    function clearData() {
        if(confirm("모든 피드백 데이터를 삭제하시겠습니까?")) {
            localStorage.removeItem('wonbong_feedback');
            showResults();
        }
    }
</script>

</body>
</html>
